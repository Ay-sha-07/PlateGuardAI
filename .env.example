# ---------------------------------------------------------------------------
# AI providers (label scanning)
# ---------------------------------------------------------------------------
# Set as many of these as you can — the app auto-detects every key that's
# present and tries them in this order: Google (Gemini), xAI (Grok), Groq,
# OpenAI, Anthropic, then the generic OpenAI-compatible option. If a scan
# gets rate-limited on the first provider it automatically retries once,
# then fails over to the next configured provider — this is what stops
# "the AI provider is rate-limiting requests" errors. That failover only
# works if you've set MORE THAN ONE key below; with just one, a rate limit
# has nowhere to fail over to and the scan will fail outright.
#
# This app's default setup: Gemini as the primary provider, with Grok as
# the fallback if Gemini is unavailable/rate-limited.
#
#   GOOGLE_GENERATIVE_AI_API_KEY   → https://aistudio.google.com/apikey (free tier) — DEFAULT
#   XAI_API_KEY (or GROK_API_KEY)  → https://console.x.ai (paid, no free tier) — FALLBACK
#   GROQ_API_KEY                   → https://console.groq.com/keys (free, 30 req/min)
#   OPENAI_API_KEY                 → https://platform.openai.com/api-keys (paid)
#   ANTHROPIC_API_KEY              → https://console.anthropic.com/settings/keys (paid)
#   OPENAI_COMPATIBLE_API_KEY      → any other OpenAI-compatible endpoint (OpenRouter, etc.)
#                                     — also set OPENAI_COMPATIBLE_BASE_URL and,
#                                     optionally, OPENAI_COMPATIBLE_MODEL
#
# Copy this file to ".env" and fill in as many as you have.

GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Optional model overrides — defaults are already sensible, only set these
# if you specifically want a different model from a given provider.
# GOOGLE_MODEL=gemini-2.5-flash
# XAI_MODEL=grok-4.6
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ---------------------------------------------------------------------------
# Supabase (cloud login + cross-device data sync)
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com, then copy its URL and anon
# key here. Without these set, the app still works fully offline/local-only
# — login just won't be available.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
