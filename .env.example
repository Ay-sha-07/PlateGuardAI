# ---------------------------------------------------------------------------
# AI providers (label scanning)
# ---------------------------------------------------------------------------
# Set as many of these as you can — the app auto-detects every key that's
# present and tries them in this order: Groq, Google, OpenAI, Anthropic,
# then the generic OpenAI-compatible option. If a scan gets rate-limited on
# the first provider it automatically retries once, then fails over to the
# next configured provider — this is what stops "the AI provider is
# rate-limiting requests" errors. That failover only works if you've set
# MORE THAN ONE key below; with just one, a rate limit has nowhere to fail
# over to and the scan will fail outright.
#
# Recommended minimum: Groq + Google. Both have workable free tiers and no
# credit card is required to get either key.
#
#   GROQ_API_KEY                   → https://console.groq.com/keys (free, 30 req/min)
#   GOOGLE_GENERATIVE_AI_API_KEY   → https://aistudio.google.com/apikey (free tier)
#   OPENAI_API_KEY                 → https://platform.openai.com/api-keys (paid)
#   ANTHROPIC_API_KEY              → https://console.anthropic.com/settings/keys (paid)
#   OPENAI_COMPATIBLE_API_KEY      → any other OpenAI-compatible endpoint (OpenRouter, etc.)
#                                     — also set OPENAI_COMPATIBLE_BASE_URL and,
#                                     optionally, OPENAI_COMPATIBLE_MODEL
#
# Copy this file to ".env" and fill in as many as you have.

GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Optional model overrides — defaults are already sensible, only set these
# if you specifically want a different model from a given provider.
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GOOGLE_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ---------------------------------------------------------------------------
# Supabase (cloud login + cross-device data sync)
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com, then copy its URL and anon
# key here. Without these set, the app still works fully offline/local-only
# — login just won't be available.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
