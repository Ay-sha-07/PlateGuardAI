# ---------------------------------------------------------------------------
# AI providers — automatic failover order
# ---------------------------------------------------------------------------
# PlateGuard tries every configured provider in the order below.
# A 429/quota/5xx/network failure moves to the next provider automatically.
#
# Recommended setup for a high-availability/free-first stack:
#   1. Gemini
#   2. Grok
#   3. Groq
#   4. Cerebras
#   5. Mistral
#   6. OpenRouter (openrouter/free)
#   7. Cloudflare Workers AI
#   8. Hugging Face Inference Providers
#   9. Local Ollama (no hosted quota)
#
# Hosted providers still have their own rate limits/free-tier limits.
# Ollama is genuinely local and has no API quota; its practical limit is
# your machine's CPU/GPU/RAM.

# --- Google Gemini ---
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# --- xAI / Grok ---
XAI_API_KEY=
# GROK_API_KEY=  # legacy alias also accepted
# XAI_MODEL=grok-4.6

# --- Groq ---
GROQ_API_KEY=
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Cerebras ---
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2506

# --- OpenRouter ---
# OpenRouter's "openrouter/free" dynamically selects a currently available
# free model that supports the capabilities required by the request.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=PlateGuard AI

# --- Cloudflare Workers AI ---
# CLOUDFLARE_BASE_URL must include your account ID, for example:
# https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BASE_URL=
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b

# --- Hugging Face Inference Providers ---
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:fastest

# --- Ollama (local, no hosted quota) ---
# Install Ollama and pull a vision model, e.g.:
#   ollama pull qwen3-vl:8b
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3-vl:8b

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Generic OpenAI-compatible endpoint ---
# Useful for any other compatible provider/self-hosted server.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ---------------------------------------------------------------------------
# Supabase (cloud login + cross-device data sync)
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com, then copy its URL and anon
# key here. Without these set, the app still works fully offline/local-only
# — login just won't be available.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
